{
  "name": "vantage",
  "version": "1.0.0",
  "private": true,
  "description": "VANTAGE — Vanity Callsign Analytics. FCC amateur radio vanity callsign intelligence platform.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "backtest": "tsx scripts/backtest.ts",
    "build": "next build",
    "deploy": "bash scripts/deploy.sh",
    "deploy:full": "bash scripts/deploy.sh --full",
    "dev": "next dev",
    "ingest": "tsx scripts/ingest.ts",
    "ingest:fetch": "tsx scripts/fetch-uls.ts",
    "ingest:full": "tsx scripts/fetch-uls.ts && tsx scripts/ingest.ts && tsx scripts/backtest.ts 400",
    "lint": "next lint",
    "refresh": "tsx scripts/refresh.ts",
    "refresh:check": "tsx scripts/refresh.ts --check",
    "refresh:watch": "tsx scripts/refresh.ts --watch",
    "scrape": "tsx scripts/scrape-uls.ts --now",
    "scrape:dry": "tsx scripts/scrape-uls.ts --now --dry-run --limit 3",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "update": "tsx scripts/update.ts",
    "update:all": "tsx scripts/update.ts --all",
    "update:status": "tsx scripts/update.ts --status",
    "validate": "tsx scripts/validate-groups.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "next": "15.1.3",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "patchright": "^1.62.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
